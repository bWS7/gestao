DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
FLASK_ENV=production
SECRET_KEY=your-flask-secret-key-change-this

# Admin inicial (opcional). Sem essas duas variaveis definidas, nenhum
# usuario admin e criado automaticamente no primeiro boot.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=troque-por-uma-senha-forte
SEED_ADMIN_NAME=Admin
